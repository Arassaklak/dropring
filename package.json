{
  "name": "dropring",
  "version": "1.0.0",
  "description": "Sürükle-bırak, çevrimdışı dosya dönüştürücü — halka menü, tarifler, hedef boyut, geri al. Windows ve macOS.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js",
    "cli": "node src/cli.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "author": "DropRing contributors",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "chokidar": "^3.6.0",
    "fast-xml-parser": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "js-yaml": "^5.5.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5",
    "tar": "^7.5.23",
    "uiohook-napi": "^1.5.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "productName": "DropRing",
  "bin": {
    "dropring": "src/cli.js"
  },
  "build": {
    "appId": "app.dropring.converter",
    "productName": "DropRing",
    "copyright": "MIT — DropRing contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/tray*.png",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/**/*.md",
      "!node_modules/**/test/**",
      "!node_modules/**/*.d.ts"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/uiohook-napi/**"
    ],
    "extraResources": [
      {
        "from": "bin/dropring",
        "to": "dropring"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.png",
      "extraFiles": [
        {
          "from": "bin/dropring.cmd",
          "to": "dropring.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "language": "1055",
      "createDesktopShortcut": true,
      "shortcutName": "DropRing",
      "artifactName": "DropRing-${version}-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "DropRing-${version}-win-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "DropRing, Finder'dan sürüklenen dosyaları dönüştürmek için kullanılır."
      },
      "artifactName": "DropRing-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "avif",
          "heic",
          "gif",
          "tiff",
          "bmp",
          "svg",
          "mp4",
          "mov",
          "mkv",
          "webm",
          "avi",
          "mp3",
          "wav",
          "flac",
          "m4a",
          "pdf",
          "docx",
          "md",
          "csv",
          "xlsx",
          "json",
          "zip"
        ],
        "name": "DropRing ile dönüştür",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "npmRebuild": false,
    "electronLanguages": [
      "tr",
      "en-US",
      "en-GB",
      "de",
      "fr",
      "es",
      "ar",
      "ru"
    ]
  }
}